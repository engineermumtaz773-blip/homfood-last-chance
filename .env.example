NEXT_PUBLIC_WORDPRESS_API_URL=
# Google AI Studio Gemini API. Server-side only; never use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Set these only after publishing signed, versioned installers at stable HTTPS URLs.
NEXT_PUBLIC_ANDROID_APK_URL=
NEXT_PUBLIC_WINDOWS_INSTALLER_URL=

# Optional credentials for the legacy direct /api/auth/google/* routes.
# The customer sign-in UI uses Supabase Auth; configure Google in its dashboard.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone OTP uses TextBee SMS. Keep these values server-side.
SMS_PROVIDER=textbee
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
OTP_PEPPER=

# Optional in development. Production requires a random 32+ character secret.
HMF_AUTH_SESSION_SECRET=

# Admin sessions use an encrypted, HttpOnly cookie. Generate a random secret of at least 32 characters.
HMF_ADMIN_SESSION_SECRET=
# Optional comma-separated admin email allowlist (defaults are defined in code).
HMF_ADMIN_EMAILS=

# Server-only WordPress account used to revalidate OTP sign-in and proxy admin data.
# Use a dedicated WordPress administrator account with an Application Password.
HMF_ADMIN_WP_USERNAME=
HMF_ADMIN_WP_APPLICATION_PASSWORD=

# Admin OTP SMTP transport. For Gmail, use smtp.gmail.com, port 465,
# SMTP_SECURE=true, and a Google App Password (not your account password).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
HMF_ADMIN_OTP_FROM_EMAIL=

# Shared, durable admin OTP and brute-force state (Upstash Redis REST).
# Required for admin sign-in; do not expose these values to the browser.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy phone-verification route credentials; new sign-up verification uses TextBee above.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Supabase. Keep the service role key server-side.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
